# Generate with: openssl rand -base64 32
WITHINGS2MQTT_TOKEN_ENCRYPTION_KEY=

# Optional Docker Compose host port.
WITHINGS2MQTT_HTTP_PORT=8080

# Required only for linking a Withings account.
WITHINGS2MQTT_WITHINGS_CLIENT_ID=
WITHINGS2MQTT_WITHINGS_CLIENT_SECRET=
WITHINGS2MQTT_WITHINGS_REDIRECT_URL=http://localhost:8080/oauth/withings/callback
